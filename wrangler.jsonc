{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hades",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "de0aa763-4f7a-47b7-912e-5af251e44c83","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c347af0353804813af6b7f6f905593e6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
